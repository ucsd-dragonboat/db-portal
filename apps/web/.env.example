NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server only (Project Settings → API); needed for email-only sign-in


ORS_API_KEY=PLACEHODLER          # openrouteservice.org — 2,000 routes + 500 matrices a day
LOCATIONIQ_API_KEY=PLACEHODLER   # locationiq.com — 5,000 requests a day, 2 a second
GEOAPIFY_API_KEY=PLACEHODLER     # geoapify.com — 3,000 credits a day
MAPBOX_ACCESS_TOKEN=PLACEHODLER  # mapbox.com — 100k routes + 100k matrix cells a month (may ask for a card)
TOMTOM_API_KEY=PLACEHODLER       # developer.tomtom.com — 20k routes a month
GRAPHHOPPER_API_KEY=PLACEHODLER  # graphhopper.com — 500 credits a day, routes of ≤5 points
